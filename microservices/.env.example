# Copy to .env and CHANGE EVERY VALUE before deploying. Never commit the real .env.
# Generate secrets with e.g.:  openssl rand -hex 32
MYSQL_ROOT_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-at-least-32-random-characters
INTERNAL_TOKEN=change-me-another-random-value
# Port on which the web app is published on the server
WEB_PORT=80
